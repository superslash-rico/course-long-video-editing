{
  "name": "course-long-video-editing",
  "displayName": "课程长视频剪辑",
  "version": "1.3.0",
  "edition": "title-first-per-course-workspace-local-update",
  "createdDate": "2026-10-22",
  "coreStages": [
    "course_title_and_dated_project_directory",
    "intake_and_mode",
    "optional_rough_cut",
    "provided_intro_outro_and_boundary_transitions",
    "subtitles",
    "real_material_research_and_capture",
    "mode_adaptive_animation",
    "provided_cover_handoff",
    "course_title_intro_and_branded_student_pdf",
    "quality_handoff",
    "local_skill_iteration"
  ],
  "wholeFirstMethodFullyIncluded": true,
  "fontsIncluded": true,
  "nativeAppIncluded": false,
  "requiresReceiverOwnProject": true,
  "validation": "validation/report.json",
  "manifest": "assets/manifest.json",
  "updatedDate": "2026-10-22",
  "professionalAnimationStatus": {
    "wholeFirstMethodImplemented": false,
    "fullStandardValidatedExampleIncluded": false,
    "partialCraftStudyIncluded": true,
    "fixedIdentityAndQuoteVisualsConfirmed": true
  },
  "videoModes": [
    "talking_head",
    "screen_tutorial"
  ],
  "mixedModeHandledPerSegment": true,
  "roughCutPolicy": {
    "askWhenUnknown": true,
    "defaultStyle": "natural-teaching",
    "alreadyRoughCutSkipsSpeechCleanup": true
  },
  "brandPackagingPolicy": {
    "source": "user-provided-with-course-video",
    "creativeGeneration": false,
    "styleSelectionRequired": false,
    "transitionBoundaries": [
      "intro-to-course",
      "course-to-outro"
    ],
    "automaticChapterCards": false,
    "missingAssets": "record-pending-and-request-needed-input; continue-independent-work; do-not-create-replacements"
  },
  "maintenancePolicy": {
    "localUpdate": "automatic-for-generalized-confirmed-learning",
    "githubPublication": "explicit-user-confirmation-required"
  },
  "newWorkflowNativePilotPerformed": false,
  "coverPolicy": {
    "source": "user-provided",
    "generation": false,
    "automaticAdaptation": false,
    "threeRatioSetRequired": false,
    "optionalSuppliedPNGRatioChecks": [
      "4:3",
      "3:4",
      "16:9"
    ],
    "suppliedOriginalsRemainProjectSpecific": true
  },
  "visualMaterialPolicy": {
    "beforeAnimationProduction": true,
    "transcriptDriven": true,
    "userMaterialsOptional": true,
    "researchOriginalSources": true,
    "actualCapturePreferredForFactualVisuals": true,
    "generatedImages": "optional-illustration-only; never-fabricated-evidence",
    "fixedRealMaterialPercentage": null,
    "perCourseAssetsRemainProjectSpecific": true
  },
  "courseCompanionPolicy": {
    "basis": "final-edited-course-content",
    "required": [
      "one-upload-ready-title",
      "short-introduction",
      "branded-student-pdf"
    ],
    "includeWhenApplicable": [
      "mindmap",
      "course-materials",
      "verified-source-links"
    ],
    "copyableTextAndEditableData": true,
    "brand": "superslash",
    "portableBrandResourcesIncluded": true,
    "publicationOrSendingAutomatic": false
  },
  "courseCompanionTemplateStatus": {
    "previewRendered": true,
    "previewPurpose": "Template usage guide only, not an actual lesson",
    "allThreePreviewPagesVisuallyInspected": true,
    "realCourseHandoutValidated": false
  },
  "projectOrganizationPolicy": {
    "trigger": "actual intent to edit a course long video, even without naming the skill",
    "firstQuestionWhenUnknown": "这次想剪辑的课程标题是什么？",
    "explicitCurrentCourseTitleReused": true,
    "folderPattern": "YYYYMMDD-课程标题",
    "dateBasis": "client/user local project creation date",
    "inputFolders": [
      "原片",
      "片头",
      "片尾",
      "封面",
      "参考资料"
    ],
    "generatedFoldersCreatedWhenNeeded": [
      "工作文件",
      "预览",
      "交付"
    ],
    "providedFiles": "assistant classifies and copies; preserve originals and verify paths/content; no silent overwrite",
    "editingStartsAfter": "title,course folder,five categories and organization of already supplied materials",
    "sameCourseContinuation": "reuse identified project directory across days",
    "publicationTitleDoesNotAutoRenameFolder": true
  }
}
